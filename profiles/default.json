{
 "name": "default",
 "description": "Starting thresholds for a general short-video delivery gate. Put project differences in a project profile (\"extends\": \"default\" or another built-in profile); do not edit this file.",
 "required": ["decode_clean", "format", "first_frame", "black_frames", "freeze", "long_freeze", "low_motion",
              "audio_clipping", "loudness", "head_silence", "tail_silence", "text_scan"],
 "audio": "required",
 "format": {"video_codec": ["h264"], "pix_fmt": ["yuv420p"], "audio_codec": ["aac"], "sample_rate": [48000],
            "width": null, "height": null, "fps": null},
 "first_frame": {"pix_th": 0.10, "black_ratio": 0.98},
 "long_freeze": {"noise": 0.003, "max_s": 5.0, "action": "fail"},
 "low_motion": {"sample_fps": 4, "diff_max": 0.8, "spike_max": 0.9, "window_s": 4.0, "action": "needs_review"},
 "silence": {"noise_db": -40, "min_s": 0.5, "head_max_s": 1.5, "head_action": "fail",
             "tail_max_s": 2.0, "tail_action": "fail", "mid_review_s": 1.0},
 "loudness": {"range": [-18.0, -10.0], "action": "needs_review"},
 "true_peak": {"max_dbtp": -1.0, "action": "needs_review"},
 "text": {"banned": ["TBD", "TODO", "FIXME", "待定", "待确认", "待补充", "待填", "占位", "placeholder", "lorem ipsum",
                     "[FIELD]"],
          "extra_banned": [], "allow": [], "require": []},
 "allow": []
}
